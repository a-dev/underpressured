    "Your presets will be removed and replaced with the defaults. You can't undo this." : {
      "comment" : "App interface label or action. Match the platform terminology and keep action verbs concise.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف إعداداتك المسبقة وتُستبدل بالإعدادات الافتراضية. لا يمكنك التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Voreinstellungen werden entfernt und durch die Standardwerte ersetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your presets will be removed and replaced with the defaults. You can't undo this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus preajustes se eliminarán y se reemplazarán por los predeterminados. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos préréglages seront supprimés et remplacés par ceux par défaut. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットは削除され、デフォルトに置き換えられます。この操作は取り消せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas predefinições serão removidas e substituídas pelas padrão. Não é possível desfazer esta ação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的预设将被移除并替换为默认预设。此操作无法撤销。"
          }
        }
      }
    }
