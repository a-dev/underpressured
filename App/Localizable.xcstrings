    "This app is translated into English, Spanish, Brazilian Portuguese, German, French, Arabic, Japanese, and Simplified Chinese. Change the language in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا التطبيق مترجم إلى الإنجليزية والإسبانية والبرتغالية البرازيلية والألمانية والفرنسية والعربية واليابانية والصينية المبسطة. غيّر اللغة في إعدادات النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist auf Englisch, Spanisch, brasilianischem Portugiesisch, Deutsch, Französisch, Arabisch, Japanisch und vereinfachtem Chinesisch verfügbar. Ändere die Sprache in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is translated into English, Spanish, Brazilian Portuguese, German, French, Arabic, Japanese, and Simplified Chinese. Change the language in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app está traducida al inglés, español, portugués de Brasil, alemán, francés, árabe, japonés y chino simplificado. Cambia el idioma en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app est traduite en anglais, espagnol, portugais du Brésil, allemand, français, arabe, japonais et chinois simplifié. Changez la langue dans Réglages Système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは英語、スペイン語、ブラジルポルトガル語、ドイツ語、フランス語、アラビア語、日本語、簡体字中国語に翻訳されています。言語はシステム設定で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app está traduzido para inglês, espanhol, português do Brasil, alemão, francês, árabe, japonês e chinês simplificado. Altere o idioma nos Ajustes do Sistema."
