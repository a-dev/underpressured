    "Couldn’t preserve Lossless JPEG quality. Source unchanged. Retry, or turn off Lossless to allow lossy encoding" : {
      "comment" : "Failure reason shown when the lossless JPEG encoder is unavailable; the source remains unchanged.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الحفاظ على جودة JPEG دون فقد. لم يتغير المصدر. أعد المحاولة أو أوقف الوضع غير الفاقد للسماح بالترميز مع فقد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlustfreie JPEG-Qualität konnte nicht erhalten werden. Quelle unverändert. Erneut versuchen oder den verlustfreien Modus für verlustbehaftete Codierung deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t preserve Lossless JPEG quality. Source unchanged. Retry, or turn off Lossless to allow lossy encoding"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conservar la calidad JPEG sin pérdida. El archivo original no se ha modificado. Vuelve a intentarlo o desactiva «Sin pérdida» para permitir la codificación con pérdida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de préserver la qualité JPEG sans perte. La source n’a pas été modifiée. Réessayez ou désactivez Sans perte pour autoriser un encodage avec perte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JPEGのロスレス画質を維持できませんでした。元画像は変更されていません。再試行するか、ロスレスをオフにして非可逆エンコードを許可してください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível manter a qualidade JPEG sem perdas. A origem não foi alterada. Tente novamente ou desative a opção sem perdas para permitir a codificação com perdas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保持 JPEG 无损质量。源文件未更改。请重试，或关闭“无损”以允许有损编码"
          }
        }
      }
    },
