    "Higher keeps more detail; lower makes smaller files." : {
      "comment" : "Help text for preset quality",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيمة الأعلى تحتفظ بتفاصيل أكثر؛ والقيمة الأقل تنتج ملفات أصغر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte erhalten mehr Details; niedrigere ergeben kleinere Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher keeps more detail; lower makes smaller files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor más alto conserva más detalles; uno más bajo crea archivos más pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une valeur élevée conserve plus de détails ; une valeur faible produit des fichiers plus légers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値を高くすると細部が保たれ、低くするとファイルが小さくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais altos mantêm mais detalhes; valores mais baixos geram arquivos menores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数值越高保留的细节越多；数值越低，文件越小。"
          }
        }
      }
    },
    "Images keep their original appearance. Resizing may change details. Saving as JPEG turns transparent areas white." : {
      "comment" : "Help text for lossless presets",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحافظ الصور على مظهرها الأصلي. قد يؤدي تغيير الحجم إلى تغيير بعض التفاصيل. عند الحفظ بصيغة JPEG، تتحول المناطق الشفافة إلى اللون الأبيض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder behalten ihr ursprüngliches Aussehen. Beim Ändern der Größe können sich Details verändern. Beim Speichern als JPEG werden transparente Bereiche weiß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images keep their original appearance. Resizing may change details. Saving as JPEG turns transparent areas white."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes conservan su aspecto original. Cambiar el tamaño puede alterar los detalles. Al guardar como JPEG, las zonas transparentes se vuelven blancas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images conservent leur apparence d’origine. Le redimensionnement peut modifier certains détails. L’enregistrement au format JPEG rend les zones transparentes blanches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の見た目は元のまま保たれます。サイズを変更すると、細部が変わる場合があります。JPEGで保存すると、透明な部分は白くなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens mantêm a aparência original. Redimensionar pode alterar os detalhes. Ao salvar como JPEG, as áreas transparentes ficam brancas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像保留原有外观。调整尺寸可能会改变细节。保存为 JPEG 时，透明区域会变为白色。"
          }
        }
      }
    },
